# Copy to .env and fill in. Never commit .env. Never expose these to the browser.

# Copy the host from the Embed tab / a workflow's API tab (docs show app.fastn.dev and live.gcp.fastn.ai)
FASTN_HOST=

# Settings > API keys. Use the narrowest preset, pin the key to the customers it may reach
# (required for keys used in an embed session). A fsk_test_ key is NOT a sandbox.
FASTN_API_KEY=

# Optional: sent as x-org-id when minting tokens
FASTN_ORG_ID=

# The customer this demo acts for. Use the customer identifier/UUID your workspace shows (Settings > Customers)
FASTN_END_ORG_ID=

# true => add tenant-id to the iframe URL (per-user connections). Confirm with the Embed tab snippet.
FASTN_USER_LEVEL=false

# Shared secret your workflows send in the x-callback-secret header to POST /api/sync-events
SYNC_CALLBACK_SECRET=change-me
