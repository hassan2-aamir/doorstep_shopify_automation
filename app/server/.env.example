# Copy to .env (never commit .env). Loaded by `npm start` via --env-file-if-exists.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=doorstep

# Shared with Fastn: store the same value as fastn.secrets callbackSecret (prompt P3).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALLBACK_SECRET=

# Demo only: stands in for a session. Printed by `npm run seed`.
DEMO_CUSTOMER_ID=

# Fastn embed. The token API lives on live.gcp.fastn.ai (app.fastn.dev serves the dashboard, not the API).
# The API key stays on the server; a fsk_test_ key is NOT a sandbox. Pin the key to the customer(s) it may reach.
FASTN_HOST=https://live.gcp.fastn.ai
FASTN_API_KEY=
# Leave EMPTY. The token API reads x-org-id as a CUSTOMER org, not yours: setting your own org id fails
# with IDENTITY_ORG_NOT_FOUND. The customer is sent as endOrgId in the request body instead.
FASTN_ORG_ID=
# true adds tenant-id to the iframe URL (User-level widget scope). Confirm with the Embed tab snippet.
FASTN_USER_LEVEL=true
