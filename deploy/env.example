# Copy to deploy/.env.production (git-ignored) and fill in. Read by provision.mjs and set-env.mjs --from-file.
# Never commit real values. NODE_ENV, WEB_DIST and FASTN_USER_LEVEL are set by the scripts.

# MongoDB Atlas connection string. The database user must be allowed to read and write the "doorstep" database.
MONGODB_URI=

# Shared secret Fastn sends in the x-callback-secret header. Must equal the Fastn org secret CALLBACK_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALLBACK_SECRET=

# Fastn embed token API. The host is live.gcp.fastn.ai, not app.fastn.dev.
FASTN_HOST=https://live.gcp.fastn.ai
FASTN_API_KEY=

# Mongo _id of the seeded demo customer (printed by `npm run seed` in app/server). Stands in for a session.
DEMO_CUSTOMER_ID=

# Optional
# MONGODB_DB=doorstep
# CALLBACK_RATE_LIMIT=300
